#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; cmd="${1:-help}"; shift || true
case "$cmd" in init) exec "$ROOT/scripts/init-project.sh" "${1:-.}";; doctor) exec "$ROOT/scripts/doctor.sh";; update) exec "$ROOT/scripts/update-curation.sh";; route) exec python3 "$ROOT/scripts/route.py" "$@";; install) exec "$ROOT/install.sh" "$@";; *) echo 'usage: vibe {init|doctor|update|route|install}';; esac
